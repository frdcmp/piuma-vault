# Builder and runtime must share the same Debian release (glibc version)
FROM rust:slim-trixie AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Build all five binaries in one compilation pass
RUN cargo build --release \
    --bin backend \
    --bin embedding-worker \
    --bin notification-worker \
    --bin cron-worker \
    --bin mcp-worker

# Runtime image
FROM debian:trixie-slim AS runtime

# libssl3: reqwest/lettre link native-tls; ca-certificates: outbound HTTPS trust
RUN apt-get update && apt-get install -y ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/backend /usr/local/bin/
COPY --from=builder /app/target/release/embedding-worker /usr/local/bin/
COPY --from=builder /app/target/release/notification-worker /usr/local/bin/
COPY --from=builder /app/target/release/cron-worker /usr/local/bin/
COPY --from=builder /app/target/release/mcp-worker /usr/local/bin/

# The binaries resolve JWT/VAPID key material from ./src/keys relative to the
# working directory (legacy fallback path) — compose mounts the host keys there.
WORKDIR /app

EXPOSE 8080

CMD ["backend"]

# mcp-worker variant: runtime + node (npx) and uv (uvx) so stdio MCP servers
# can be spawned as child processes. Only the mcp-worker service builds this
# target (docker-compose.prod.yml sets `target: mcp-runtime`); every other
# service stays on the lean `runtime` stage above.
FROM runtime AS mcp-runtime

RUN apt-get update && apt-get install -y nodejs npm && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

CMD ["mcp-worker"]
