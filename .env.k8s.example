# Cluster (k3s) configuration — TEMPLATE. Copy to .env.k8s and fill in.
#
#   cp .env.k8s.example .env.k8s && chmod 600 .env.k8s
#   ./k8s/render-config.sh          # -> k8s/00-config.yaml + k8s/.rendered/ (gitignored)
#   kubectl apply -f k8s/00-config.yaml -f k8s/.rendered/
#
# .env.k8s is the PRODUCTION file read by k8s/render-config.sh, which applies
# no overrides: what is written here is what the pods receive. The separate
# .env is the DEV file for docker compose and is never read by the cluster.
#
# This repo is PUBLIC: .env.k8s itself is gitignored and must never be
# committed, encrypted or otherwise. Only this template is published.
#
# Keys in the SECRETS section render into a k8s Secret; the rest a ConfigMap.

# ---------- config (ConfigMap) ----------
ALLOW_REGISTRATION=""
BASE_URL=""
CORS_ALLOWED_ORIGINS=""
CORS_ALLOW_LOCAL=""
DB_HOST=db
DB_NAME=""
DB_PORT=5432
DB_USER=""
DB_VERIFY_SCHEMA=""
MCP_WORKER_URL=http://mcp-worker:8090
RUST_LOG=info
# SERVER_NAME is injected per-pod by the Deployments (fieldRef), not set here.
SITE_URL=""
TELEMETRY_INGEST_URL=""

# ---------- deploy-time (read by render-config.sh, not put in the ConfigMap) ----------
# The in-cluster registry the manifests' __REGISTRY__ placeholder resolves to.
REGISTRY_HOST="registry.<your-tailnet>.ts.net"

# ---------- SECRETS (k8s Secret) — never commit real values ----------
CLOUDFLARED_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
DB_PASSWORD=""
TELEMETRY_API_KEY=""
