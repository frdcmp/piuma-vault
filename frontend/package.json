{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare:pdfjs": "mkdir -p public/pdfjs && cp -R node_modules/pdfjs-dist/cmaps node_modules/pdfjs-dist/standard_fonts node_modules/pdfjs-dist/wasm public/pdfjs/",
    "dev": "bun run prepare:pdfjs && bun run theme:build && vite",
    "build": "bun run prepare:pdfjs && bun run theme:build && vite build",
    "theme:build": "bun scripts/build-tokens.mjs",
    "theme:lint": "bun scripts/lint-theme.mjs",
    "theme:mobile": "bun scripts/build-tokens.mjs --mobile ../mobile",
    "lint": "bun run theme:lint && biome check .",
    "format": "biome format --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@milkdown/components": "^7.21.1",
    "@milkdown/core": "^7.21.1",
    "@milkdown/ctx": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/plugin-history": "^7.21.1",
    "@milkdown/plugin-listener": "^7.21.1",
    "@milkdown/preset-commonmark": "^7.21.1",
    "@milkdown/preset-gfm": "^7.21.1",
    "@milkdown/prose": "^7.21.1",
    "@milkdown/react": "^7.21.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@tanstack/react-query": "^5.90.20",
    "@uiw/react-md-editor": "^4.1.0",
    "axios": "^1.12.1",
    "dayjs": "^1.11.18",
    "fractional-indexing": "^3.2.0",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.3",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.18.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "vite-plugin-compression": "^0.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.2"
  }
}
