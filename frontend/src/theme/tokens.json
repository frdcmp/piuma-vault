{
	"$doc": "Single source of truth for every colour, font, radius and shadow (web + mobile). Edit here, then `bun run theme:build`. `primitives` are raw values; each theme maps semantic tokens onto them with {primitive} refs. Emitted as --vp-<token> CSS variables (src/theme/tokens.css), a JS object (src/theme/tokens.js) and the mobile palette (mobile/src/theme/tokens.js).",
	"primitives": {
		"black": "#000000",
		"white": "#ffffff",
		"ink-900": "#0e0f12",
		"ink-800": "#15171c",
		"ink-700": "#1b1e25",
		"ink-600": "#1f232b",
		"line-500": "#2a2f3a",
		"line-400": "#3a4150",
		"slate-500": "#3a4049",
		"slate-400": "#525966",
		"slate-300": "#6a7380",
		"fg-100": "#d6dbe5",
		"fg-400": "#8a93a3",
		"fg-600": "#5b6373",
		"yellow": "#f7c948",
		"green": "#5cd0a9",
		"red": "#ff6b6b",
		"blue": "#6cb6ff",
		"orange": "#ffa94d",
		"violet": "#c084fc"
	},
	"defaultTheme": "mono",
	"themes": {
		"mono": {
			"label": "Mono (dark)",
			"scheme": "dark",
			"tokens": {
				"bg": "{ink-900}",
				"bg-soft": "{ink-800}",
				"panel": "{ink-700}",
				"panel-alt": "{ink-600}",
				"border": "{line-400}",
				"border-soft": "{line-500}",
				"text": "{fg-100}",
				"muted": "{fg-400}",
				"faint": "{fg-600}",
				"accent": "{yellow}",
				"success": "{green}",
				"danger": "{red}",
				"info": "{blue}",
				"warning": "{orange}",
				"violet": "{violet}",
				"on-accent": "{ink-900}",
				"shadow-color": "{black}",
				"highlight": "{white}",
				"scrollbar-track": "{ink-900}",
				"scrollbar-thumb": "{slate-500}",
				"scrollbar-thumb-hover": "{slate-400}",
				"scrollbar-thumb-active": "{slate-300}"
			}
		}
	},
	"static": {
		"font": "\"JetBrainsMono Nerd Font\", \"JetBrains Mono\", \"Courier New\", monospace",
		"font-display": "\"Press Start 2P\", \"JetBrainsMono Nerd Font\", \"JetBrains Mono\", monospace",
		"font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
		"radius": "0px",
		"shadow": "2px 2px 0 0 var(--vp-shadow-color)",
		"shadow-lg": "4px 4px 0 0 var(--vp-shadow-color)"
	},
	"legacyAliases": {
		"$doc": "Old names kept so existing CSS keeps working during the migration. Removed at the end of the design-system plan (phase 5).",
		"accent-2": "success",
		"accent-3": "danger",
		"accent-4": "info",
		"mono": "font"
	}
}
